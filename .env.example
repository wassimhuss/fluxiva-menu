VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_APP_URL=http://localhost:5173
# Optional. WhatsApp number Fluxiva is reached on for renewals; shown as a button
# in the owner's expiry warning. Leave unset to show the warning without a button.
VITE_SUPPORT_WHATSAPP=

# Only needed to run migrations (scripts/apply-migration.mjs). Supabase ->
# Project Settings -> Database -> Connection string -> Session pooler. The
# publishable key above is SELECT-only and cannot run DDL.
SUPABASE_DB_URL=
